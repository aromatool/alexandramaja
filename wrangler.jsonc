{
  // Cloudflare Workers deploy (Astro Cloudflare adapter, Workers-only).
  //
  // The public site is prerendered to static files in ./dist and served from
  // the CDN via the ASSETS binding. Keystatic's admin API route runs on-demand
  // in the Worker (entrypoint below). `nodejs_compat` is required because
  // Keystatic's server code uses Node APIs. `npx wrangler deploy` reads this.
  "name": "alexandramaja",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  // Plaintext env vars, versioned here so they SURVIVE every Git deploy.
  // (Variables added only via the Cloudflare dashboard get wiped on the next
  // `wrangler deploy`, since this file is the source of truth.)
  //
  // MAILERLITE_GROUP_ID = "Scrisori de suflet" — newsletter sign-ups from the
  // site are added to this group. NOT a secret, just an identifier.
  // The API key (MAILERLITE_API_KEY) stays a SECRET in the dashboard — never here.
  "vars": {
    "MAILERLITE_GROUP_ID": "193702956451759960"
  }
}
