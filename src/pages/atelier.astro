---
import BaseLayout from '../layouts/BaseLayout.astro';
import BotanicalDivider from '../components/BotanicalDivider.astro';
import AtelierBag from '../components/AtelierBag.astro';
import { getCollection } from 'astro:content';

// ============================================================================
// ATELIERUL ALEXANDREI — prototip INTERN, ascuns.
//   • noindex, nofollow (vezi <BaseLayout noindex>)
//   • scos din sitemap (astro.config) și din robots.txt
//   • NU e în meniu / footer
//   • fără checkout, fără coș — doar experiența, designul, structura
// Regula de aur: între „arată a magazin" și „arată a atelierul Alexandrei",
// alegem mereu a doua variantă.
// ============================================================================

// --- Produsele din atelier (fundație în Keystatic) ---
const all = (await getCollection('atelier')).filter((p) => !p.data.draft);

// Cărțile stau într-o secțiune vizuală separată — nu se amestecă cu cremele.
const products = all.filter((p) => p.data.category !== 'Cărți');
const books = all.filter((p) => p.data.category === 'Cărți');

// „Din caietul meu" — legăm atelierul de Bibliotecă, ca produsul să aibă o
// lume în jurul lui, nu doar un preț. Alegem articole despre plante/uleiuri.
const journal = (await getCollection('biblioteca'))
  .filter((a) => !a.data.draft)
  .filter((a) => a.data.category === 'Plante' || a.data.category === 'Aromaterapie')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

// Procesul — de la plantă la produs. Nu patru carduri corporate: patru gesturi.
const process = [
  {
    n: 'I',
    title: 'Culeg',
    text: 'Plante pe care le cunosc și le aleg — de pe versanții pe care urc în fiecare an, din grădină, de la marginea pădurii. Le adun când sunt gata, nu când îmi convine mie.',
    note: 'Fotografie: mâini care culeg, plante de munte, lumină de dimineață',
  },
  {
    n: 'II',
    title: 'Pregătesc',
    text: 'Usuc, macerez, infuzez. E partea în care nu se vede nimic și trece timp — săptămâni în care uleiul prinde încet culoarea și mirosul plantei.',
    note: 'Fotografie: borcane de macerat la fereastră, flori uscate, in',
  },
  {
    n: 'III',
    title: 'Încerc',
    text: 'Formulez și ajustez. Schimb o proporție, aștept, miros din nou. Fac și desfac până când simt că e bine — nu până când e „destul de bine".',
    note: 'Fotografie: mortar și pistil, note de mână, picături',
  },
  {
    n: 'IV',
    title: 'Creez',
    text: 'Produsul final, în cantități mici. Fiecare lot iese puțin diferit, pentru că plantele nu sunt niciodată identice — și mie asta îmi place.',
    note: 'Fotografie: cremă într-un recipient simplu, ceramică, masă de lemn',
  },
];
---

<BaseLayout
  title="Atelierul Alexandrei"
  description="Un mic atelier de lucruri făcute cu mâna — creme, ceaiuri și cărți, din plante, timp și curiozitate."
  noindex={true}
>
  <!-- ======================= HERO ======================= -->
  <section class="atl-hero tactile-linen">
    <div class="container atl-hero-grid">
      <div class="atl-hero-text">
        <span class="eyebrow">Atelier</span>
        <h1 class="atl-hero-title">Atelierul Alexandrei</h1>
        <p class="atl-hero-sub">
          Lucruri pe care le fac încet, din plante, timp și multă curiozitate.
        </p>
        <a href="#atelier-acum" class="atl-hero-link">Descoperă ce am creat ↓</a>
      </div>
      <figure class="atl-hero-figure photo-ph" data-note="Fotografie lifestyle: masă veche de lemn, plante proaspete și uscate, borcane cu macerate, mortar, ceramică, o cremă simplă — lumină de Provence">
        <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M20 34 V15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
          <path d="M20 17 c0-4 2.2-7 5.6-8.2 -0.3 4-2.2 7-5.6 8.2Z" fill="currentColor" fill-opacity="0.2" />
          <path d="M20 17 c0-4 -2.2-7 -5.6-8.2 0.3 4 2.2 7 5.6 8.2Z" fill="currentColor" fill-opacity="0.2" />
          <path d="M20 24 c0-3 2-5.4 5-6.4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
          <path d="M20 24 c0-3 -2-5.4 -5-6.4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" />
        </svg>
      </figure>
    </div>
  </section>

  <BotanicalDivider />

  <!-- ================ DE LA PLANTĂ LA PRODUS ================ -->
  <section class="section">
    <div class="container">
      <header class="atl-head">
        <span class="eyebrow">Cum se nasc lucrurile</span>
        <h2>De la plantă la produs</h2>
        <p class="lead atl-head-lead">
          Nu cumperi un obiect de pe un raft. Iei o bucată dintr-un proces care
          începe cu mult înainte, pe un versant de munte sau la o fereastră.
        </p>
      </header>

      <ol class="steps">
        {
          process.map((s) => (
            <li class="step">
              <figure class="step-media photo-ph" data-note={s.note}>
                <span class="step-num" aria-hidden="true">{s.n}</span>
              </figure>
              <div class="step-text">
                <h3 class="step-title">{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ================ CE ESTE ACUM ÎN ATELIER ================ -->
  <section id="atelier-acum" class="section surface-cream tactile-linen">
    <div class="container">
      <header class="atl-head">
        <span class="eyebrow">În atelier acum</span>
        <h2>Ce este acum în atelier</h2>
        <p class="lead atl-head-lead">
          O colecție mică, atent aleasă. Unele lucruri apar doar într-un anotimp
          și se termină până le fac din nou.
        </p>
      </header>

      <div class="pieces">
        {
          products.map((p) => {
            const d = p.data;
            const photo = d.images?.[0];
            return (
              <article class:list={['piece', { 'is-featured': d.featured }]}>
                <figure class="piece-media photo-ph" data-note="Fotografie de produs, în context — nu izolată pe alb">
                  {photo?.image ? (
                    <img src={photo.image} alt={photo.alt ?? d.title} loading="lazy" decoding="async" onerror="this.remove()" />
                  ) : (
                    <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M20 33 V16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                      <path d="M20 18 c0-3.6 2-6.4 5-7.4 -0.3 3.6-2 6.4-5 7.4Z" fill="currentColor" fill-opacity="0.2" />
                      <path d="M20 18 c0-3.6 -2-6.4 -5-7.4 0.3 3.6 2 6.4 5 7.4Z" fill="currentColor" fill-opacity="0.2" />
                    </svg>
                  )}
                </figure>
                <div class="piece-text">
                  <span class="piece-cat">{d.category}</span>
                  <h3 class="piece-name">{d.title}</h3>
                  <p class="piece-story">{d.shortDescription}</p>
                  <div class="piece-tags">
                    {d.batch && <span class="tag">{d.batch}</span>}
                    {d.season && <span class="tag">{d.season}</span>}
                    {d.availability && d.availability !== 'În atelier acum' && (
                      <span class="tag tag-quiet">{d.availability}</span>
                    )}
                  </div>
                  {d.price && (
                    <div class="piece-price"><span class="price-tag">{d.price}</span></div>
                  )}
                  <div class="piece-actions">
                    {d.availability === 'În atelier acum' && (
                      <button type="button" class="bag-add" data-bag-add data-id={p.id} data-name={d.title} data-price={d.price ?? ''}>
                        Pune în desagă
                      </button>
                    )}
                    <a href={`/atelier/${p.id}`} class="piece-more">Descoperă →</a>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <BotanicalDivider />

  <!-- ==================== CĂRȚILE MELE ==================== -->
  <section class="section">
    <div class="container-narrow mx-auto">
      <header class="atl-head">
        <span class="eyebrow">Din cuvinte</span>
        <h2>Cărțile mele</h2>
        <p class="lead atl-head-lead">
          Unele lucruri le fac din plante. Altele din cuvinte.
        </p>
      </header>
    </div>

    <div class="container">
      <div class="books">
        {
          books.map((b) => {
            const d = b.data;
            const cover = d.images?.[0];
            return (
              <article class="book">
                <figure class="book-cover" data-note="Mockup: cartea pe o masă, lângă plante / cană / creion">
                  {cover?.image ? (
                    <img src={cover.image} alt={cover.alt ?? d.title} loading="lazy" decoding="async" onerror="this.remove()" />
                  ) : (
                    <span class="book-cover-title">{d.title}</span>
                  )}
                </figure>
                <div class="book-text">
                  <h3 class="book-name">{d.title}</h3>
                  <p class="book-desc">{d.shortDescription}</p>
                  {d.audience && <p class="book-audience">{d.audience}</p>}
                  {d.price && (
                    <div class="book-price"><span class="price-tag">{d.price}</span></div>
                  )}
                  <div class="book-actions">
                    {d.availability === 'În atelier acum' && (
                      <button type="button" class="bag-add" data-bag-add data-id={b.id} data-name={d.title} data-price={d.price ?? ''}>
                        Pune în desagă
                      </button>
                    )}
                    <a href={`/atelier/${b.id}`} class="piece-more">Descoperă cartea →</a>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- ==================== LOTURI MICI ==================== -->
  <section class="section surface-lavender tactile-linen atl-batches">
    <div class="container-reading mx-auto text-center">
      <span class="eyebrow">Loturi mici</span>
      <h2 class="atl-batches-h">Nu fac lucrurile pe bandă.</h2>
      <p class="atl-batches-text">
        Unele apar doar într-un anumit anotimp. Unele se termină și revin abia
        când găsesc din nou plantele potrivite. Prefer să fac puțin și bine
        decât mult și fără poveste.
      </p>
    </div>
  </section>

  <!-- ================== DIN CAIETUL MEU ================== -->
  {
    journal.length > 0 && (
      <section class="section">
        <div class="container atl-journal">
          <figure class="journal-media photo-ph" data-note="Fotografie: un borcan de macerat lângă un caiet deschis">
            <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M20 33 V16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
              <path d="M20 18 c0-3.6 2-6.4 5-7.4 -0.3 3.6-2 6.4-5 7.4Z" fill="currentColor" fill-opacity="0.2" />
              <path d="M20 18 c0-3.6 -2-6.4 -5-7.4 0.3 3.6 2 6.4 5 7.4Z" fill="currentColor" fill-opacity="0.2" />
            </svg>
          </figure>
          <div class="journal-text">
            <span class="eyebrow">Din caietul meu</span>
            <h2>O lume în jurul fiecărui lucru</h2>
            <p class="journal-intro">
              Un produs nu e doar ceva de cumpărat. Are în spate o plantă, un
              drum, o poveste. Câteva dintre ele le-am scris deja:
            </p>
            <ul class="journal-list">
              {journal.map((a) => (
                <li>
                  <a href={`/biblioteca/${a.id}`} class="journal-link">
                    <span class="journal-link-title">{a.data.title}</span>
                    <span class="journal-link-desc">{a.data.description}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }

  <BotanicalDivider />

  <!-- ==================== FINAL / NEWSLETTER ==================== -->
  <section class="section atl-final">
    <div class="container-reading mx-auto text-center">
      <p class="atl-final-line">Atelierul se schimbă odată cu anotimpurile.</p>
      <p class="atl-final-invite">
        Dacă vrei să afli când apare ceva nou, îți poți lăsa adresa de email.
      </p>
      <form class="atl-form" data-newsletter>
        <label class="visually-hidden" for="atl-email">Adresa ta de email</label>
        <input
          id="atl-email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder="adresa ta de email"
        />
        <button type="submit" class="btn btn-outline">Anunță-mă</button>
        <p class="atl-form-note" data-newsletter-note hidden>
          Gata — te anunț când apare ceva nou în atelier.
        </p>
        <p class="atl-form-error" data-newsletter-error hidden>
          Ceva n-a mers. Mai încearcă o dată în câteva momente.
        </p>
      </form>
    </div>
  </section>

  <AtelierBag />
</BaseLayout>

<style>
  /* Textură discretă „in / hârtie" — foarte subtilă, doar cât să se simtă. */
  .tactile-linen {
    background-image:
      repeating-linear-gradient(0deg, rgba(120, 100, 80, 0.022) 0 1px, transparent 1px 4px),
      repeating-linear-gradient(90deg, rgba(120, 100, 80, 0.022) 0 1px, transparent 1px 4px);
  }

  /* ===================== HERO ===================== */
  .atl-hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(2rem, 5vw, 3.5rem);
  }
  .atl-hero-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .atl-hero-text {
    max-width: 44ch;
  }
  .atl-hero-title {
    margin-block: 0.5rem 1.5rem;
  }
  .atl-hero-sub {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.8vw, 1.85rem);
    line-height: 1.4;
    font-style: italic;
    color: var(--accent-lavender-deep);
    max-width: 30ch;
  }
  .atl-hero-link {
    display: inline-block;
    margin-top: 2rem;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    color: var(--accent-sage-dark);
    text-decoration: none;
    border-bottom: 1px solid var(--accent-pink);
    padding-bottom: 2px;
  }
  .atl-hero-link:hover {
    color: var(--accent-lavender-deep);
  }
  .atl-hero-figure {
    margin: 0;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
  }
  .atl-hero-figure svg {
    width: 60px;
    height: 60px;
    opacity: 0.5;
  }

  @media (max-width: 820px) {
    .atl-hero-grid {
      grid-template-columns: 1fr;
    }
    .atl-hero-text {
      order: 2;
    }
    .atl-hero-figure {
      order: 1;
    }
  }

  /* ===================== HEADINGS DE SECȚIUNE ===================== */
  .atl-head {
    max-width: 46ch;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .atl-head h2 {
    margin-top: 0.4rem;
  }
  .atl-head-lead {
    margin-top: 1rem;
  }

  /* ===================== DE LA PLANTĂ LA PRODUS ===================== */
  .steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .step {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  /* alternăm partea — pagină de revistă, nu carduri identice */
  .step:nth-child(even) .step-media {
    order: 2;
  }
  .step:nth-child(even) .step-text {
    order: 1;
  }
  /* mic decalaj, ca să nu fie perfect aliniate */
  .step:nth-child(odd) {
    margin-right: auto;
    max-width: 96%;
  }
  .step:nth-child(even) {
    margin-left: auto;
    max-width: 96%;
  }
  .step-media {
    aspect-ratio: 5 / 4;
    border-radius: var(--radius-lg);
    position: relative;
  }
  .step-num {
    position: absolute;
    top: 0.9rem;
    left: 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    letter-spacing: 0.06em;
    color: var(--accent-terracotta-deep);
    opacity: 0.8;
  }
  .step-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 0.6rem;
  }
  .step-text p {
    color: var(--text-secondary);
  }

  /* ===================== PRODUSE (editorial) ===================== */
  .pieces {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vw, 6rem);
  }
  .piece {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  /* alternăm latura imaginii */
  .piece:nth-child(even) .piece-media {
    order: 2;
  }
  .piece:nth-child(even) .piece-text {
    order: 1;
  }
  /* produsele „normale" — mai mici și decalate; cele featured — mari, centrate */
  .piece:not(.is-featured) {
    max-width: 86%;
  }
  .piece:not(.is-featured):nth-child(odd) {
    margin-right: auto;
  }
  .piece:not(.is-featured):nth-child(even) {
    margin-left: auto;
  }
  .piece.is-featured {
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .piece-media {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .piece.is-featured .piece-media {
    aspect-ratio: 5 / 4;
  }
  .piece-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .piece-media svg {
    width: 48px;
    height: 48px;
    opacity: 0.5;
  }
  .piece-cat {
    font-size: 0.6875rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent-sage-dark);
    font-weight: 600;
  }
  .piece-name {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    line-height: 1.1;
    margin: 0.5rem 0 0.75rem;
  }
  .piece.is-featured .piece-name {
    font-size: clamp(2rem, 4.5vw, 3rem);
  }
  .piece-story {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.15rem, 2.2vw, 1.4rem);
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 34ch;
  }
  .piece-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }
  .tag {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-terracotta-deep);
    border: 1px solid var(--border-soft);
    background-color: var(--bg-soft);
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }
  .tag-quiet {
    color: var(--text-muted);
  }
  .piece-price {
    margin-top: 1rem;
  }
  .book-price {
    margin-top: 0.9rem;
  }
  .piece-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 1.1rem;
  }
  .book-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.9rem;
  }
  .piece-actions .piece-more,
  .book-actions .piece-more {
    margin-top: 0;
  }
  .piece-more {
    display: inline-block;
    margin-top: 1.25rem;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    color: var(--accent-sage-dark);
    border-bottom: 1px solid var(--accent-pink);
    padding-bottom: 2px;
  }

  @media (max-width: 760px) {
    .step,
    .piece,
    .piece.is-featured {
      grid-template-columns: 1fr;
      max-width: 100%;
    }
    .step:nth-child(even) .step-media,
    .piece:nth-child(even) .piece-media {
      order: 0;
    }
    .step:nth-child(even) .step-text,
    .piece:nth-child(even) .piece-text {
      order: 0;
    }
  }

  /* ===================== CĂRȚI ===================== */
  .books {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    justify-content: center;
  }
  .book {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 300px;
  }
  .book-cover {
    aspect-ratio: 3 / 4;
    width: 100%;
    max-width: 260px;
    border-radius: 3px 8px 8px 3px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    overflow: hidden;
    background:
      radial-gradient(120% 120% at 25% 20%, var(--tint-lavender) 0%, transparent 60%),
      linear-gradient(150deg, #efe7dd, #e5ddcd);
    box-shadow:
      -6px 8px 22px -8px rgba(49, 45, 29, 0.4),
      inset 6px 0 12px -8px rgba(49, 45, 29, 0.25);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  /* cotorul cărții */
  .book-cover::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 8px;
    background: linear-gradient(90deg, rgba(49, 45, 29, 0.18), transparent);
  }
  .book:hover .book-cover {
    transform: translateY(-4px) rotate(-0.6deg);
    box-shadow:
      -8px 12px 28px -8px rgba(49, 45, 29, 0.45),
      inset 6px 0 12px -8px rgba(49, 45, 29, 0.25);
  }
