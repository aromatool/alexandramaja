  { id: 'bogo-dus-cu-eucalipt', name: 'Dup cu eucalipt', cod: '53517', price: '124 lei', tier: 'bogo', note: 'Eucalyptus Blue 5 ml + Eucalyptus Radiata 5 ml', image: img('bogo-dus-cu-eucalipt') },
  { id: 'bogo-armonie-florala', name: 'Armonie florală', cod: '53534', price: '237 lei', tier: 'bogo', note: 'White Angelica 5 ml + Palmarosa 15 ml', image: img('bogo-armonie-florala') },
