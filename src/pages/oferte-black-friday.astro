  .bf-card .price-tag,
  .bf-panel :global(.price-tag) {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.75rem;
    /* roșul de pe bulinele „-40%"/„FREE" din pozele oficiale YL, pentru
       consecvență cu pozele produselor — nu e în paleta calmă a site-ului. */
    color: #ab3432;
    background: none;
    border: none;
    box-shadow: none;
    padding: 0;
    border-radius: 0;
  }
  .bf-card .price-tag::before,
  .bf-panel :global(.price-tag::before) {
    content: none;
  }
  .bf-add {
    margin-top: 0.8rem;
    font-family: var(--font-body);
    font-size: 0.88rem;
    padding: 0.55rem 0.9rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--accent-terracotta-deep);
    background: none;
    color: var(--accent-terracotta-deep);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .bf-add:hover {
    background-color: var(--accent-terracotta-deep);
    color: var(--button-text);
