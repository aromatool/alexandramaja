---
// Pagină ASCUNSĂ — nu e în meniu, nu e în sitemap (vezi astro.config.mjs),
// noindex. Acces doar prin linkul trimis de Alexandra prin email. Campanie
// de 3 zile (18-20 nov 2026) — date introduse direct aici, nu în Keystatic,
// ca să nu construim o colecție CMS întreagă pentru o pagină temporară.
import BaseLayout from '../layouts/BaseLayout.astro';
import BlackFridayBag from '../components/BlackFridayBag.astro';

type Tier = '50' | '40' | '30' | '20' | 'bundle' | 'starter' | 'bogo';

