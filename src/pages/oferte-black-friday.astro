---

<BaseLayout title="Oferte Black Friday — Team Maja" noindex>
  <article class="bf">
    <h1 class="sr-only">Oferte Black Friday Young Living — reduceri până la 50%</h1>
    <div class="container mx-auto">
      <img
        class="bf-hero-full"
        src="/images/black-friday/hero-full.png"
        alt="Oferte Black Friday Young Living, 18-20 noiembrie 2026. Reduceri speciale la produsele tale preferate, bundle-uri avantajoase și cadouri exclusive — reduceri până la 50%. Cadou la 550 PV: valiză YL Oil & Go cu difuzor, ulei Vanilla, The Gift și Cassia. Transport gratuit la primele comenzi de 100 PV+, sau la comenzi de 125 PV+ pentru Brand Partners."
        loading="eager"
      />
    </div>

    <div class="container-narrow mx-auto bf-products-title text-center">
      <span class="eyebrow">Oferte de 3 zile</span>
      <h2>Produse în promoție</h2>
    </div>

    <div class="container-narrow mx-auto bf-filters" data-bf-filters>
      {
        filters.map((f, i) => (
          <button type="button" class="bf-filter" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label}
          </button>
        ))
      }
    </div>

    <div class="container-narrow mx-auto bf-grid" data-bf-grid>
      {
        offers.map((o) => (
          <article class="bf-card" data-tier={o.tier}>
            <button
              type="button"
              class="bf-card-btn"
              data-bf-details
              data-id={o.id}
              data-name={o.name}
              data-cod={o.cod}
              data-price={o.price}
              data-size={o.size ?? ''}
              data-note={o.note ?? ''}
              data-image={o.image ?? ''}
            >
              <figure class:list={['bf-media', { 'photo-ph': !o.image }]} data-note={!o.image ? 'Poză produs/bundle' : undefined}>
                {o.image ? (
                  <img src={o.image} alt={o.name} loading="lazy" decoding="async" />
                ) : (
                  <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M20 33 V16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                    <path d="M20 18 c0-3.6 2-6.4 5-7.4 -0.3 3.6-2 6.4-5 7.4Z" fill="currentColor" fill-opacity="0.2" />
                    <path d="M20 18 c0-3.6 -2-6.4 -5-7.4 0.3 3.6 2 6.4 5 7.4Z" fill="currentColor" fill-opacity="0.2" />
                  </svg>
                )}
              </figure>
              <div class="bf-body">
                <h3 class="bf-name">{o.name}{o.size ? ` (${o.size})` : ''}</h3>
                {o.note && <p class="bf-note">{o.note}</p>}
                {o.cod && <p class="bf-cod">Cod: {o.cod}</p>}
                <div class="bf-price-row">
                  <span class="price-tag">{o.price}</span>
                </div>
                <span class="bf-details-link">Vezi detalii →</span>
              </div>
            </button>
          </article>
        ))
      }
    </div>

    <p class="container-narrow mx-auto bf-footnote">
      Comenzile pot fi plasate doar pe comandă unică, nu pe puncte. Reducerile
      la bundle-uri se aplică la achiziția produselor împreună.
    </p>
  </article>

  <div class="bf-panel-overlay" data-bf-panel-overlay hidden></div>
  <aside class="bf-panel" data-bf-panel hidden aria-label="Detalii produs" role="dialog" aria-modal="true">
    <button type="button" class="bf-panel-close" data-bf-panel-close aria-label="Închide">×</button>
    <figure class:list={['bf-panel-media']} data-bf-panel-media>
      <img data-bf-panel-img src="" alt="" />
    </figure>
    <h2 class="bf-panel-name" data-bf-panel-name></h2>
    <p class="bf-panel-cod" data-bf-panel-cod></p>
    <div class="bf-price-row" data-bf-panel-price></div>
    <p class="bf-panel-note" data-bf-panel-note></p>
    <p class="bf-panel-hint">Îl adaugi în lista ta — poți alege oricâte produse și vezi totalul în orice moment.</p>
    <button type="button" class="bf-add" data-bfbag-add data-bf-panel-add>Adaugă în listă</button>
  </aside>

  <BlackFridayBag />
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .bf-hero-full {
    display: block;
    width: 100%;
  }

  .bf-products-title {
    margin-top: clamp(3rem, 6vw, 4rem);
  }

  .bf-filters {
    margin-top: clamp(2rem, 4vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }
  .bf-filter {
    font-family: var(--font-body);
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1.5px solid var(--border-soft);
    background-color: var(--bg-soft);
    color: var(--text-secondary);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }
  .bf-filter:hover {
    border-color: var(--accent-terracotta);
  }
  .bf-filter[aria-pressed='true'] {
    background-color: var(--accent-terracotta-deep);
    border-color: var(--accent-terracotta-deep);
    color: var(--button-text);
  }

  .bf-grid {
    margin-top: clamp(2rem, 4vw, 2.5rem);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
    gap: 1rem;
  }
  .bf-grid[data-filtering] .bf-card[hidden] {
    display: none;
  }

  .bf-card {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-card);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .bf-card-btn {
    display: flex;
    flex-direction: column;
    width: 100%;
    font: inherit;
    text-align: left;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: inherit;
  }

  .bf-media {
    position: relative;
    aspect-ratio: 1;
    background-color: var(--bg-card);
  }
  .bf-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .bf-media.photo-ph svg {
    width: 48px;
    height: 48px;
    opacity: 0.5;
  }
  .bf-body {
    padding: 1rem 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    text-align: center;
  }
  .bf-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--text-main);
    margin: 0;
    line-height: 1.25;
  }
  .bf-note {
    margin: 0.2rem 0 0;
    font-size: 0.82rem;
    color: var(--text-secondary);
    font-style: italic;
  }
  .bf-cod {
    margin: 0.3rem 0 0;
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .bf-price-row {
    margin-top: 0.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .bf-card .price-tag,
  .bf-panel :global(.price-tag) {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.75rem;
    /* roșul de pe bulinele „-40%"/„FREE" din pozele oficiale YL, pentru
       consecvență cu pozele produselor — nu e în paleta calmă a site-ului. */
    color: #ab3432;
    background: none;
    border: none;
    box-shadow: none;
    padding: 0;
    border-radius: 0;
  }
  .bf-card .price-tag::before,
  .bf-panel :global(.price-tag::before) {
    content: none;
  }
  .bf-add {
    margin-top: 0.8rem;
    font-family: var(--font-body);
    font-size: 0.88rem;
    padding: 0.55rem 0.9rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--accent-terracotta-deep);
    background: none;
    color: var(--accent-terracotta-deep);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .bf-add:hover {
    background-color: var(--accent-terracotta-deep);
    color: var(--button-text);
  }

  .bf-details-link {
    margin-top: 0.7rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-terracotta-deep);
  }

  .bf-panel-overlay {
    position: fixed;
    inset: 0;
    z-index: 70;
    background-color: rgba(49, 45, 29, 0.28);
    backdrop-filter: blur(1px);
  }
  .bf-panel-overlay[hidden] { display: none; }

  .bf-panel {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 80;
    width: min(420px, 92vw);
    height: 100%;
    background-color: var(--bg-page);
    border-left: 1px solid var(--border-soft);
    box-shadow: -16px 0 44px rgba(49, 45, 29, 0.16);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .bf-panel[hidden] { display: none; }

  .bf-panel-close {
    align-self: flex-end;
    background: none;
    border: none;
    font-size: 1.75rem;
    line-height: 1;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.25rem;
  }
  .bf-panel-close:hover { color: var(--text-main); }

  .bf-panel-media {
    position: relative;
    aspect-ratio: 1;
    max-width: 260px;
    margin: 0 auto 1rem;
    background-color: var(--bg-card);
    border-radius: var(--radius-lg);
  }
  .bf-panel-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .bf-panel-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--text-main);
    margin: 0;
  }
  .bf-panel-cod {
    margin: 0.2rem 0 0;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .bf-panel .bf-price-row {
    margin-top: 0.8rem;
  }
  .bf-panel-note {
    margin-top: 0.8rem;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .bf-panel-hint {
    margin-top: 0.8rem;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .bf-panel .bf-add {
    margin-top: 1.2rem;
  }

  .bf-footnote {
    margin: clamp(2.5rem, 5vw, 3.5rem) auto clamp(3rem, 6vw, 4rem);
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
    max-width: 52ch;
  }
</style>

<script>
  const filtersWrap = document.querySelector<HTMLElement>('[data-bf-filters]');
  const grid = document.querySelector<HTMLElement>('[data-bf-grid]');
  if (filtersWrap && grid) {
    grid.setAttribute('data-filtering', '');
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.bf-card'));
    filtersWrap.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement)?.closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;
      const key = btn.dataset.filter ?? 'all';
      filtersWrap.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      cards.forEach((card) => {
        card.hidden = key !== 'all' && card.dataset.tier !== key;
      });
    });
  }

  const panelOverlay = document.querySelector<HTMLElement>('[data-bf-panel-overlay]');
  const panel = document.querySelector<HTMLElement>('[data-bf-panel]');
  if (panelOverlay && panel) {
    const imgEl = panel.querySelector<HTMLImageElement>('[data-bf-panel-img]');
    const nameEl = panel.querySelector<HTMLElement>('[data-bf-panel-name]');
    const codEl = panel.querySelector<HTMLElement>('[data-bf-panel-cod]');
    const priceEl = panel.querySelector<HTMLElement>('[data-bf-panel-price]');
    const noteEl = panel.querySelector<HTMLElement>('[data-bf-panel-note]');
    const addEl = panel.querySelector<HTMLButtonElement>('[data-bf-panel-add]');

    const openPanel = (btn: HTMLElement) => {
      const { id, name, cod, price, size, note, image } = btn.dataset;

      if (imgEl) {
        if (image) {
          imgEl.src = image;
          imgEl.alt = name ?? '';
          imgEl.hidden = false;
        } else {
          imgEl.hidden = true;
        }
      }
      if (nameEl) nameEl.textContent = size ? `${name} (${size})` : name ?? '';
      if (codEl) {
        codEl.textContent = cod ? `Cod: ${cod}` : '';
        codEl.hidden = !cod;
      }
      if (priceEl) {
        priceEl.innerHTML = '';
        const cur = document.createElement('span');
        cur.className = 'price-tag';
        cur.textContent = price ?? '';
        priceEl.appendChild(cur);
      }
      if (noteEl) {
        noteEl.textContent = note ?? '';
        noteEl.hidden = !note;
      }
      if (addEl) {
        addEl.dataset.id = id ?? '';
        addEl.dataset.name = name ?? '';
        addEl.dataset.cod = cod ?? '';
        addEl.dataset.price = price ?? '';
      }

      panelOverlay.hidden = false;
      panel.hidden = false;
    };

    const closePanel = () => {
      panelOverlay.hidden = true;
      panel.hidden = true;
    };

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement)?.closest<HTMLElement>('[data-bf-details]');
      if (btn) openPanel(btn);
    });
    panel.querySelector('[data-bf-panel-close]')?.addEventListener('click', closePanel);
    panelOverlay.addEventListener('click', closePanel);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePanel();
    });
  }
</script>
