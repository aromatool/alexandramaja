    font-size: 1.5rem;
    color: var(--text-main);
    margin: 0;
  }
  .bf-panel-cod {
    margin: 0.2rem 0 0;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .bf-panel .bf-price-row {
    margin-top: 0.8rem;
  }
  .bf-panel-note {
    margin-top: 0.8rem;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .bf-panel-desc {
    margin-top: 1rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }
  .bf-panel-desc :global(p) {
    margin: 0 0 0.7rem;
  }
  .bf-panel-desc :global(ul) {
    margin: 0 0 0.9rem;
    padding-left: 1.15rem;
  }
  .bf-panel-desc :global(li) {
    margin-bottom: 0.35rem;
  }
  .bf-panel-desc :global(.bf-desc-tag) {
    font-style: italic;
    color: var(--text-muted);
  }
  .bf-panel-desc :global(.bf-desc-callout) {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--accent-sage-dark);
    background-color: var(--tint-sage);
    padding: 0.6rem 0.8rem;
    border-radius: var(--radius-sm);
  }
  .bf-panel-hint {
    margin-top: 0.8rem;
    font-size: 0.85rem;
    font-style: italic;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .bf-panel .bf-add {
    margin-top: 1.2rem;
  }

  .bf-footnote {
    margin: clamp(2.5rem, 5vw, 3.5rem) auto clamp(3rem, 6vw, 4rem);
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
    max-width: 52ch;
  }
</style>

<script>
  const filtersWrap = document.querySelector<HTMLElement>('[data-bf-filters]');
  const grid = document.querySelector<HTMLElement>('[data-bf-grid]');
  if (filtersWrap && grid) {
    grid.setAttribute('data-filtering', '');
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.bf-card'));
    filtersWrap.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement)?.closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;
      const key = btn.dataset.filter ?? 'all';
      filtersWrap.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      cards.forEach((card) => {
        card.hidden = key !== 'all' && card.dataset.tier !== key;
      });
    });
  }

  const panelOverlay = document.querySelector<HTMLElement>('[data-bf-panel-overlay]');
  const panel = document.querySelector<HTMLElement>('[data-bf-panel]');
  if (panelOverlay && panel) {
    const imgEl = panel.querySelector<HTMLImageElement>('[data-bf-panel-img]');
    const nameEl = panel.querySelector<HTMLElement>('[data-bf-panel-name]');
    const codEl = panel.querySelector<HTMLElement>('[data-bf-panel-cod]');
    const priceEl = panel.querySelector<HTMLElement>('[data-bf-panel-price]');
    const noteEl = panel.querySelector<HTMLElement>('[data-bf-panel-note]');
    const descEl = panel.querySelector<HTMLElement>('[data-bf-panel-desc]');
    const addEl = panel.querySelector<HTMLButtonElement>('[data-bf-panel-add]');

    const openPanel = (btn: HTMLElement) => {
      const { id, name, cod, price, size, note, description, image, outOfStock } = btn.dataset;

      if (imgEl) {
        if (image) {
          imgEl.src = image;
          imgEl.alt = name ?? '';
          imgEl.hidden = false;
        } else {
          imgEl.hidden = true;
        }
      }
      if (nameEl) nameEl.textContent = size ? `${name} (${size})` : name ?? '';
      if (codEl) {
        codEl.textContent = cod ? `Cod: ${cod}` : '';
        codEl.hidden = !cod;
      }
      if (priceEl) {
        priceEl.innerHTML = '';
        const cur = document.createElement('span');
        cur.className = 'price-tag';
        cur.textContent = price ?? '';
        priceEl.appendChild(cur);
      }
      if (noteEl) {
        noteEl.textContent = note ?? '';
        noteEl.hidden = !note;
      }
      if (descEl) {
        descEl.innerHTML = description ?? '';
        descEl.hidden = !description;
      }
      if (addEl) {
        addEl.dataset.id = id ?? '';
        addEl.dataset.name = name ?? '';
        addEl.dataset.cod = cod ?? '';
        addEl.dataset.price = price ?? '';
        addEl.disabled = outOfStock === 'true';
        addEl.textContent = outOfStock === 'true' ? 'Stoc epuizat' : 'Adaugă în listă';
      }

      panelOverlay.hidden = false;
      panel.hidden = false;
    };

    const closePanel = () => {
      panelOverlay.hidden = true;
      panel.hidden = true;
    };

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement)?.closest<HTMLElement>('[data-bf-details]');
      if (btn) openPanel(btn);
    });
    panel.querySelector('[data-bf-panel-close]')?.addEventListener('click', closePanel);
    panelOverlay.addEventListener('click', closePanel);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePanel();
    });
  }
</script>
