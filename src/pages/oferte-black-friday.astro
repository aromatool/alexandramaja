  .bf-panel-close:hover { color: var(--text-main); }

  .bf-panel-media {
    position: relative;
    aspect-ratio: 1;
    max-width: 260px;
    margin: 0 auto 1rem;
    background-color: var(--bg-card);
    border-radius: var(--radius-lg);
  }
  .bf-panel-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
