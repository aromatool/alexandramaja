// Campania de Cyber Monday 2026 (se încheie 25 noiembrie, ora 21:00, sau
// în limita stocurilor). Pagina e reutilizată de la Black Friday — același
// mecanism, alte produse.
const CAMPAIGN_OPEN = true;

const filters: { key: 'all' | Tier; label: string }[] = [
  { key: 'all', label: `Toate produsele (${offers.length})` },
  { key: 'singles', label: `Produse single (${offers.filter((o) => o.tier === 'singles').length})` },
  { key: 'bogo', label: `1+1 Gratis (${offers.filter((o) => o.tier === 'bogo').length})` },
  { key: 'bundle', label: `Bundle-uri (${offers.filter((o) => o.tier === 'bundle').length})` },
  { key: 'starter', label: `Starter Kit-uri (${offers.filter((o) => o.tier === 'starter').length})` },
];
---

<BaseLayout title="Oferte Cyber Monday — Team Maja" noindex>
  <article class="bf">
    <h1 class="sr-only">Oferte Cyber Monday Young Living — reduceri până la 50%</h1>
    {CAMPAIGN_OPEN && (
    <div class="container mx-auto">
      <img
        class="bf-hero-full"
        src="/images/cyber-monday/hero-full.png"
        alt="Oferte Cyber Monday Young Living, 23-25 noiembrie 2026. Reduceri speciale la produsele tale preferate, bundle-uri avantajoase și cadouri exclusive — reduceri până la 50%. Cadou la 550 PV: Difuzor Aria, Aromatizator Knitted Ceramic, ulei Vanilla, The Gift și Cassia. Transport gratuit la primele comenzi de 100 PV+, sau la comenzi de 125 PV+ pentru Brand Partners."
        loading="eager"
      />
    </div>
    )}

    {!CAMPAIGN_OPEN && (
      <div class="container-narrow mx-auto bf-closed">
        <span class="eyebrow">Black Friday s-a încheiat</span>
        <h2>Mulțumim pentru comenzi!</h2>
        <p>
          Oferta de Black Friday s-a încheiat — nu se mai pot plasa comenzi pe această pagină.
          Urmează însă <strong>Cyber Monday</strong>, cu reduceri noi la alte produse. Revino aici
          în curând sau urmărește-mă pentru anunț.
        </p>
      </div>
    )}

    {CAMPAIGN_OPEN && (<>
    <div class="container-narrow mx-auto bf-products-title text-center">
      <span class="eyebrow">Timp limitat</span>
      <h2>Produse în promoție</h2>
    </div>

    <div class="container-narrow mx-auto bf-filters" data-bf-filters>
      {
        filters.map((f, i) => (
          <button type="button" class="bf-filter" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label}
          </button>
        ))
      }
    </div>

    <div class="container-narrow mx-auto bf-grid" data-bf-grid>
      {
        offers.map((o) => (
          <article class:list={['bf-card', { 'bf-card-oos': o.outOfStock }]} data-tier={o.tier}>
            <button
              type="button"
              class="bf-card-btn"
              data-bf-details
              data-id={o.id}
              data-name={o.name}
              data-cod={o.cod}
              data-price={o.price}
              data-size={o.size ?? ''}
              data-note={o.note ?? ''}
              data-description={o.description ?? ''}
              data-image={o.image ?? ''}
              data-out-of-stock={o.outOfStock ? 'true' : 'false'}
            >
              {o.outOfStock && <span class="bf-oos-ribbon">Stoc epuizat</span>}
              <figure class:list={['bf-media', { 'photo-ph': !o.image }]} data-note={!o.image ? 'Poză produs/bundle' : undefined}>
                {o.image ? (
                  <img src={o.image} alt={o.name} loading="lazy" decoding="async" />
                ) : (
                  <svg viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M20 33 V16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                    <path d="M20 18 c0-3.6 2-6.4 5-7.4 -0.3 3.6-2 6.4-5 7.4Z" fill="currentColor" fill-opacity="0.2" />
                    <path d="M20 18 c0-3.6 -2-6.4 -5-7.4 0.3 3.6 2 6.4 5 7.4Z" fill="currentColor" fill-opacity="0.2" />
                  </svg>
                )}
              </figure>
              <div class="bf-body">
                <h3 class="bf-name">{o.name}{o.size ? ` (${o.size})` : ''}</h3>
                {o.note && <p class="bf-note">{o.note}</p>}
                {o.cod && <p class="bf-cod">Cod: {o.cod}</p>}
                <div class="bf-price-row">
                  <span class="price-tag">{o.price}</span>
                </div>
                <span class="bf-details-link">Vezi detalii →</span>
              </div>
            </button>
          </article>
        ))
      }
    </div>

    <p class="container-narrow mx-auto bf-footnote">
      Comenzile pot fi plasate doar pe comandă unică, nu pe puncte. Reducerile
      la bundle-uri se aplică la achiziția produselor împreună.
    </p>
    </>)}
  </article>

  {CAMPAIGN_OPEN && (<>
  <div class="bf-panel-overlay" data-bf-panel-overlay hidden></div>
  <aside class="bf-panel" data-bf-panel hidden aria-label="Detalii produs" role="dialog" aria-modal="true">
    <button type="button" class="bf-panel-close" data-bf-panel-close aria-label="Închide">×</button>
    <figure class:list={['bf-panel-media']} data-bf-panel-media>
      <img data-bf-panel-img src="" alt="" />
    </figure>
    <h2 class="bf-panel-name" data-bf-panel-name></h2>
    <p class="bf-panel-cod" data-bf-panel-cod></p>
    <div class="bf-price-row" data-bf-panel-price></div>
    <p class="bf-panel-note" data-bf-panel-note></p>
    <div class="bf-panel-desc" data-bf-panel-desc></div>
    <p class="bf-panel-hint">Îl adaugi în lista ta — poți alege oricâte produse și vezi totalul în orice moment.</p>
    <button type="button" class="bf-add" data-bfbag-add data-bf-panel-add>Adaugă în listă</button>
  </aside>

  <BlackFridayBag />
  </>)}
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .bf-hero-full {
    display: block;
    width: 100%;
  }

  .bf-products-title {
    margin-top: clamp(3rem, 6vw, 4rem);
  }

  .bf-closed {
    margin-top: clamp(4rem, 10vw, 7rem);
    margin-bottom: clamp(4rem, 10vw, 7rem);
    text-align: center;
  }
  .bf-closed h2 {
    margin: 0.5rem 0 1.2rem;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    color: var(--text-main);
  }
  .bf-closed p {
    max-width: 46ch;
    margin: 0 auto;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .bf-filters {
    margin-top: clamp(2rem, 4vw, 2.5rem);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
  }
  .bf-filter {
    font-family: var(--font-body);
    font-size: 0.9rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    border: 1.5px solid var(--border-soft);
    background-color: var(--bg-soft);
    color: var(--text-secondary);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
