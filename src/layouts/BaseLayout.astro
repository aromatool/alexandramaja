---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  /** Pagini interne/nepublice — le scoate din Google (noindex, nofollow). */
  noindex?: boolean;
}

const {
  title,
  description = 'Alexandra Maja — despre plante, aromaterapie și o viață trăită natural. O privire holistică asupra somnului, stresului, alimentației și stării de bine.',
  image = '/og-default.jpg',
  article = false,
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const siteName = 'Alexandra Maja';
const pageTitle = title ? `${title} — ${siteName}` : `${siteName} — viață naturală, cu discernământ`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site).toString();

// --- Structured data (JSON-LD) ---
// Un singur graf pe care Google îl citește ca să înțeleagă „cine e Alexandra"
// și, pe articole, „ce este acest text, cine l-a scris, când". Deblochează
// rezultatele bogate (autor, dată) și asociază conținutul cu autorul.
const siteURL = Astro.site!.toString();
const personId = `${siteURL}#person`;
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Person',
    '@id': personId,
    name: 'Alexandra Maja',
    url: siteURL,
    description:
      'Autoare și pasionată de plante medicinale, aromaterapie și un stil de viață natural, cu o abordare holistică.',
    knowsAbout: ['aromaterapie', 'plante medicinale', 'uleiuri esențiale', 'stil de viață natural'],
  },
  {
    '@type': 'WebSite',
    '@id': `${siteURL}#website`,
    url: siteURL,
    name: siteName,
    inLanguage: 'ro-RO',
    publisher: { '@id': personId },
  },
];
if (article) {
  graph.push({
    '@type': 'BlogPosting',
    headline: title,
    description,
    image: imageURL,
    datePublished: publishedTime,
    dateModified: modifiedTime ?? publishedTime,
    author: { '@id': personId },
    publisher: { '@id': personId },
    mainEntityOfPage: canonicalURL.toString(),
    inLanguage: 'ro-RO',
  });
}
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:locale" content="ro_RO" />
    {article && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {article && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {article && <meta property="article:author" content={siteName} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <!-- Fonts: Cormorant Garamond (display) + Lora (body) + The Girl Next Door (script) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&family=The+Girl+Next+Door&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="visually-hidden">Sari la conținut</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Cloudflare Web Analytics — statistici de trafic, gratuit și fără cookies
         (prietenos GDPR, nu necesită banner de consimțământ). Token public. -->
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "8845e454e1f045c7966f63909ffbd315"}'
      is:inline></script>
  </body>
</html>
