// de pe produsele sezoniere. Monocrom (currentColor), moștenește culoarea.
---
<svg class="sprout-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <!-- tulpină -->
  <path d="M12 20 V11" />
  <!-- două frunzulițe crescând -->
  <path d="M12 13 c0-3 2-5.4 5-6.4 -0.2 3 -2 5.4 -5 6.4 Z" fill="currentColor" fill-opacity="0.22" />
  <path d="M12 14 c0-3 -2-5.4 -5-6.4 0.2 3 2 5.4 5 6.4 Z" fill="currentColor" fill-opacity="0.22" />
  <!-- solul (linia de jos, sugerată) -->
  <path d="M7 20 H17" opacity="0.6" />
</svg>
