---
const message = 'Bună, Alexandra! Am citit un articol pe site-ul tău și mi-ar plăcea să povestim puțin.';
const whatsappHref = `https://wa.me/40754015566?text=${encodeURIComponent(message)}`;
---

<aside class="conversation" aria-labelledby="conversation-heading">
  <div class="conversation-inner">
    <h2 id="conversation-heading">Mai povestim?</h2>
    <p class="conversation-text">
      Dacă ți-a rămas o întrebare sau un gând după ce ai citit,
      scrie-mi. Îți răspund cu drag.
    </p>
    <a
      class="conversation-link"
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Scrie-i Alexandrei pe WhatsApp"
    >
      Scrie-mi pe WhatsApp
      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14m-6-6 6 6-6 6" />
      </svg>
    </a>
  </div>
</aside>

<style>
  .conversation {
    max-width: 900px;
    margin-inline: auto;
    background: var(--tint-lavender);
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 4vw, 2.9rem) clamp(1.5rem, 5vw, 3rem);
    text-align: center;
  }

  .conversation-inner {
    max-width: 510px;
    margin-inline: auto;
  }

  .conversation h2 {
    font-size: clamp(1.85rem, 3.4vw, 2.35rem);
    margin-bottom: 0.55rem;
  }

  .conversation-text {
    margin-inline: auto;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-secondary);
  }

  .conversation-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding: 0.25rem 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--accent-sage-dark);
    text-decoration: underline;
    text-decoration-color: var(--accent-sage);
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
  }

  .conversation-link:hover {
    color: var(--text-main);
    text-decoration-color: currentColor;
  }

  .conversation-link:focus-visible {
    outline: 2px solid var(--accent-lavender);
    outline-offset: 5px;
  }

  .conversation-link svg {
    flex: 0 0 auto;
    transition: transform 0.2s ease;
  }

  .conversation-link:hover svg {
    transform: translateX(2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .conversation-link svg { transition: none; }
  }
</style>
