---
// Formular reutilizabil: nume/contact + un mesaj scurt → salvează cererea
// într-un tab din Google Sheet (per `source`) și deschide WhatsApp cu un
// mesaj scurt, pre-completat, direct către Alexandra. Fără cont, fără coș —
// aceeași filozofie „conversațională” ca desaga din Atelier.
import { WHATSAPP_NUMBER } from '../lib/atelier';

export interface RequestFieldConfig {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'textarea';
  required?: boolean;
  autocomplete?: string;
  rows?: number;
}

interface Props {
  source: string;
  fields: RequestFieldConfig[];
  submitLabel?: string;
  successNote: string;
  errorNote?: string;
  whatsappTemplate: string;
  idPrefix?: string;
  showDelivery?: boolean;
}

const {
  source,
  fields,
  submitLabel = 'Trimite',
  successNote,
  errorNote = 'Ceva n-a mers la trimitere. Mai încearcă o dată sau scrie-mi direct pe WhatsApp.',
  whatsappTemplate,
  idPrefix = source,
  showDelivery = false,
} = Astro.props;
---

<div class="request-wrap">
  <form
    class="request-form"
    data-request-form
    data-source={source}
    data-whatsapp-template={whatsappTemplate}
    data-wa={WHATSAPP_NUMBER}
  >
    {
      fields.map((f) => (
        <div class="field">
          <label for={`${idPrefix}-${f.name}`}>{f.label}</label>
          {f.type === 'textarea' ? (
            <textarea id={`${idPrefix}-${f.name}`} name={f.name} rows={f.rows ?? 3} required={f.required} />
          ) : (
            <input
              id={`${idPrefix}-${f.name}`}
              name={f.name}
              type={f.type ?? 'text'}
              required={f.required}
              autocomplete={f.autocomplete}
            />
          )}
        </div>
      ))
    }
    {showDelivery && (
      <>
        <label class="delivery-toggle">
          <input type="checkbox" name="livrare_check" data-delivery-check />
          <span>Dorești livrare prin curier?</span>
        </label>
        <div class="delivery-fields" data-delivery-fields hidden>
          <div class="field">
            <label for={`${idPrefix}-adresa`}>Adresă (stradă, nr., bloc, ap.)</label>
            <input id={`${idPrefix}-adresa`} name="adresa" type="text" autocomplete="street-address" />
          </div>
          <div class="field field--row">
            <div>
              <label for={`${idPrefix}-oras`}>Oraș</label>
              <input id={`${idPrefix}-oras`} name="oras" type="text" autocomplete="address-level2" />
            </div>
            <div>
              <label for={`${idPrefix}-judet`}>Județ</label>
              <input id={`${idPrefix}-judet`} name="judet" type="text" autocomplete="address-level1" />
            </div>
          </div>
          <div class="field">
            <label for={`${idPrefix}-cod`}>Cod poștal</label>
            <input id={`${idPrefix}-cod`} name="codPostal" type="text" autocomplete="postal-code" />
          </div>
        </div>
      </>
    )}
    <button type="submit" class="btn btn-warm">{submitLabel}</button>
  </form>
  <p class="request-note" data-request-note hidden>{successNote}</p>
  <p class="request-error" data-request-error hidden>{errorNote}</p>
</div>

<style>
  .request-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 560px;
    margin-inline: auto;
  }

  .request-form[hidden] {
    display: none;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .field label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .field input,
  .field textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius);
    border: 1.5px solid var(--border-soft);
    background-color: var(--bg-soft);
    color: var(--text-main);
    width: 100%;
    resize: vertical;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent-lavender);
  }

  .delivery-toggle {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .delivery-toggle input[type='checkbox'] {
    width: 1.1rem;
    height: 1.1rem;
    accent-color: var(--accent-lavender);
    cursor: pointer;
    flex-shrink: 0;
  }

  .delivery-fields {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    border: 1.5px solid var(--border-soft);
    background: var(--bg-soft);
  }
  .delivery-fields[hidden] { display: none; }

  .field--row {
    flex-direction: row;
    gap: 1rem;
  }
  .field--row > div {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .field--row label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .request-form .btn {
    align-self: center;
    margin-top: 0.5rem;
  }

  .request-note {
    margin-top: 1.5rem;
    text-align: center;
    font-weight: 600;
    color: var(--accent-sage-dark);
    max-width: 46ch;
    margin-inline: auto;
  }

  .request-error {
    margin-top: 1.5rem;
    text-align: center;
    color: var(--accent-terracotta-deep);
    max-width: 46ch;
    margin-inline: auto;
  }
</style>

<script>
  function fillTemplate(template: string, fields: Record<string, string>): string {
    return template.replace(/\{\{(\w+)\}\}/g, (_, key: string) => fields[key] ?? '');
  }

  document.querySelectorAll<HTMLFormElement>('form[data-request-form]').forEach((form) => {
    const wrap = form.parentElement;
    const note = wrap?.querySelector<HTMLElement>('[data-request-note]');
    const errorNote = wrap?.querySelector<HTMLElement>('[data-request-error]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const source = form.dataset.source ?? '';
    const template = form.dataset.whatsappTemplate ?? '';
    const wa = form.dataset.wa ?? '';

    const deliveryCheck = form.querySelector<HTMLInputElement>('[data-delivery-check]');
    const deliveryFields = form.querySelector<HTMLElement>('[data-delivery-fields]');

    deliveryCheck?.addEventListener('change', () => {
      if (deliveryFields) deliveryFields.hidden = !deliveryCheck.checked;
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (errorNote) errorNote.hidden = true;

      const data = new FormData(form);
      const fieldsObj: Record<string, string> = {};
      data.forEach((value, key) => {
        fieldsObj[key] = String(value);
      });

      const wantsDelivery = deliveryCheck?.checked ?? false;
      const adresa = (form.querySelector<HTMLInputElement>('[name="adresa"]')?.value ?? '').trim();
      const oras = (form.querySelector<HTMLInputElement>('[name="oras"]')?.value ?? '').trim();
      const judet = (form.querySelector<HTMLInputElement>('[name="judet"]')?.value ?? '').trim();
      const cod = (form.querySelector<HTMLInputElement>('[name="codPostal"]')?.value ?? '').trim();

      const deliveryPayload: Record<string, string> = {
        livrare: wantsDelivery ? 'da' : 'nu',
        ...(wantsDelivery && adresa ? { adresa } : {}),
        ...(wantsDelivery && oras ? { oras } : {}),
        ...(wantsDelivery && judet ? { judet } : {}),
        ...(wantsDelivery && cod ? { codPostal: cod } : {}),
      };

      if (button) {
        button.disabled = true;
        button.textContent = 'Se trimite…';
      }

      // Sheet: best-effort — nu blocăm WhatsApp dacă webhook-ul eșuează
      fetch('/api/request', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ source, fields: { ...fieldsObj, ...deliveryPayload } }),
      }).catch(() => {});

      form.hidden = true;
      if (note) note.hidden = false;

      let message = fillTemplate(template, fieldsObj);
      if (wantsDelivery && adresa) {
        const loc = [adresa, cod ? `${cod} ${oras}` : oras, judet].filter(Boolean).join(', ');
        message += `\n\nLivrare la:\n${loc}`;
      }
      if (message && wa) {
        window.location.href = `https://wa.me/${wa}?text=${encodeURIComponent(message)}`;
      }
    });
  });
</script>
